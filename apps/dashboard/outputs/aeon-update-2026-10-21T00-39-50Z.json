    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "hl_heading": {
      "type": "Heading",
      "props": {
        "text": "Highlights",
        "level": "h3"
      }
    },
    "hl_1": {
      "type": "Text",
      "props": {
        "text": "onchain-monitor on Robinhood Chain",
        "variant": "body"
      }
    },
    "hl_2": {
      "type": "Text",
      "props": {
        "text": "plugin 0.2.0 hosted MCP",
        "variant": "body"
      }
    },
    "hl_3": {
      "type": "Text",
      "props": {
        "text": "validate-config flags misspelled skill keys",
        "variant": "body"
      }
    },
    "hl_4": {
      "type": "Text",
      "props": {
        "text": "gateway plan-limit fallback fix",
        "variant": "body"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "manual_heading": {
      "type": "Heading",
      "props": {
        "text": "Manual",
        "level": "h3"
      }
    },
    "manual_row": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
