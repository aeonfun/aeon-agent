        "stat_files"
      ]
    },
    "stat_commits": {
      "type": "Stat",
      "props": {
        "label": "Upstream commits synced",
        "value": "13"
      }
    },
    "stat_files": {
      "type": "Stat",
      "props": {
        "label": "Files applied cleanly",
        "value": "41"
      }
    },
    "applied": {
      "type": "Text",
      "props": {
        "text": "Applied 41 files cleanly (workflow aeon.yml auto-merged 3-way).",
        "variant": "body"
      }
