    "card": {
      "type": "Card",
      "props": {
        "title": "aeon-update — 2026-10-21"
      },
      "children": [
        "main"
      ]
    },
    "main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "sync_row",
        "stats_row",
        "applied",
        "sep1",
        "hl_heading",
        "hl_1",
        "hl_2",
        "hl_3",
        "hl_4",
        "sep2",
        "manual_heading",
        "manual_row",
        "manual_alert"
      ]
    },
    "sync_row": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
